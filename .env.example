# Copy to .env and fill in. .env is gitignored.
#
# Required by the data pipeline (scripts/run-all.js, scripts/fetch-devs.js).
# Without it, `node scripts/run-all.js --incremental 0` exits with
# "Missing GitHub token. Set MY_GITHUB_PAT in .env".
#
# Only public data is read (/search/users, /users/:u, /users/:u/events,
# /users/:u/repos, /users/:u/social_accounts), so a classic PAT with NO scopes
# or a fine-grained token with only "Public Repositories: Read" is enough.
# Never grant write scopes.
#
# You do NOT need this to work on the frontend: `npm run dev` reads the
# committed public/data.json, and `--dry-run` skips GitHub entirely.
MY_GITHUB_PAT=

# Optional. Points the frontend at the Cloudflare Worker that serves AI
# summaries and rank badges. Defaults to the deployed Worker when unset, so
# leave it blank unless you are running your own.
VITE_SUMMARY_API_URL=
